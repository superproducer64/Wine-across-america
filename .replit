modules = ["nodejs-20", "javascript", "python-3.11"]
[agent]
expertMode = true
integrations = ["javascript_anthropic_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["yakut"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
printf 'EXPO_PUBLIC_SUPABASE_URL=%s
EXPO_PUBLIC_SUPABASE_ANON_KEY=%s
' \"$EXPO_PUBLIC_SUPABASE_URL\" \"$EXPO_PUBLIC_SUPABASE_ANON_KEY\" > .env.local && npx expo start --web --port 5000 --clear"""
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "node_modules/.bin/serve dist -l 5000 --single"]
build = ["bash", "-c", "echo EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL > .env.local && echo EXPO_PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY >> .env.local && npx expo export --platform web"]
publicDir = "dist"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5001
externalPort = 80
