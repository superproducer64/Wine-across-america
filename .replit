modules = ["nodejs-20", "javascript"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["yakut"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Video Preview"

[[workflows.workflow]]
name = "Video Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:client"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "node_modules/.bin/serve dist -l 5000 --single"]
build = ["bash", "-c", "echo EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL > .env.local && echo EXPO_PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY >> .env.local && npx expo export --platform web"]
publicDir = "dist"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
